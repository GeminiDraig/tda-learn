{
  // Build task used by launch.json (Ctrl+Shift+B also works).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-slnx",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/tda-examples.slnx"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
